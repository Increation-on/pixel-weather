{
  "expo": {
    "name": "pixel-weather",
    "slug": "pixel-weather",
    "assetBundlePatterns": [
      "assets/icons/*",
      "assets/notifications-icons/*" // ← ДОБАВЬ ЭТУ СТРОКУ!
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/favicon/icon.png", // оставляем для мобильных
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/favicon/icon.png",
        "backgroundColor": "#1a1f2e"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./public/favicon.ico" // ← указываем путь из public/
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}